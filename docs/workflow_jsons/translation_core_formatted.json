          "jsCode": "const input = $input.first().json;\nconst output = input.output || '';\nconst hasContent = output.trim().length > 10;\nconst looksLikeKorean = /[\u3131-\u314e\u314f-\u3163\uac00-\ud7a3]/.test(output);\nif (!hasContent) return [{ json: { ...input, quality_check: 'empty', passed: false } }];\nif (looksLikeKorean) return [{ json: { ...input, quality_check: 'still_korean', passed: false } }];\nreturn [{ json: { ...input, quality_check: 'ok', passed: true } }];"
