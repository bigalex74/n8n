      {
        "parameters": {
          "jsCode": "const input = $('Start Workflow').first().json;\nconst chunkText = input.chunk_text || '';\nconst systemPrompt = input.system_prompt || '';\nconst userPrompt = input.user_prompt || '';\nconst glossary = input.glossary || '';\nconst ragContext = input.rag_context || '';\nconst rollingSummary = input.rolling_summary || '';\nconst arcSummary = input.arc_summary || '';\nconst prevLine = input.prev_line || '';\n\nlet fullUserPrompt = '';\nif (rollingSummary) fullUserPrompt += '## \u041a\u0420\u0410\u0422\u041a\u041e\u0415 \u0421\u041e\u0414\u0415\u0420\u0416\u0410\u041d\u0418\u0415 \u041f\u0420\u0415\u0414\u042b\u0414\u0423\u0429\u0415\u0419 \u0413\u041b\u0410\u0412\u042b:\\n' + rollingSummary + '\\n\\n';\nif (arcSummary) fullUserPrompt += '## \u041a\u0420\u0410\u0422\u041a\u041e\u0415 \u041e\u041f\u0418\u0421\u0410\u041d\u0418\u0415 \u0422\u0415\u041a\u0423\u0429\u0415\u0419 \u0410\u0420\u041a\u0418:\\n' + arcSummary + '\\n\\n';\nif (prevLine) fullUserPrompt += '<CONTEXT_BEFORE>\\n' + prevLine + '\\n</CONTEXT_BEFORE>\\n\\n';\nif (userPrompt) fullUserPrompt += userPrompt + '\\n\\n';\nfullUserPrompt += '## \u041f\u0415\u0420\u0415\u0412\u0415\u0414\u0418 \u0421\u0422\u0420\u041e\u0413\u041e \u041d\u0410 \u0420\u0423\u0421\u0421\u041a\u0418\u0419:\\n' + chunkText;\n\nlet fullSystemPrompt = systemPrompt;\nif (glossary) fullSystemPrompt = fullSystemPrompt.replace('{{GLOSSARY}}', '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\u0413\u041b\u041e\u0421\u0421\u0410\u0420\u0418\u0419 \u2014 \u0418\u0421\u0422\u041e\u0427\u041d\u0418\u041a \u0418\u0421\u0422\u0418\u041d\u042b\\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n' + glossary);\nif (ragContext) fullSystemPrompt = fullSystemPrompt.replace('{{LIGHT_RAG}}', '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\u0411\u0410\u0417\u0410 \u0417\u041d\u0410\u041d\u0418\u0419 \u041c\u0418\u0420\u0410 (\u041a\u041e\u041d\u0422\u0415\u041a\u0421\u0422 \u0418\u0417 RAG)\\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n' + ragContext);\nif (prevLine) fullSystemPrompt = fullSystemPrompt.replace('{{CONTEXT_BEFORE}}', '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\u0421\u0415\u041a\u0426\u0418\u042f<CONTEXT_BEFORE>\\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\u041d\u0415 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u044c.\\n\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0441\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430.');\n\nconst isTest = input.is_devops_test === true;\nlet modelConfig = input.model_config || { mainModel: 'ollama', mainModelName: 'llama3.2:3b', baseUrl: 'http://127.0.0.1:11434' };\nif (isTest) {\n  modelConfig = { mainModel: 'openai', mainModelName: 'google/gemini-2.0-flash-001', baseUrl: 'http://127.0.0.1:5000' };\n  console.log('\u26a0\ufe0f DEVOPS SAFETY SWITCH ACTIVATED');\n}\n\nreturn [{ json: { chunk_text: chunkText, system_prompt: fullSystemPrompt, user_prompt: fullUserPrompt, model_config: modelConfig, start_time: Date.now(), test_id: input.test_id || 'translation-core', attempt: 0 } }];"
