[{"updatedAt":"2026-07-13T20:58:55.370Z","createdAt":"2026-07-13T17:48:46.284Z","id":"KoreanOcrYd2026A","name":"OCR — Yandex Disk Korean screenshots","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"ocr-yandex-korean-batch","authentication":"headerAuth","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1120,-176],"id":"2f4ea17c-2539-456c-aed1-3b17240ad29c","name":"Authenticated batch webhook","webhookId":"c74eea09-95b6-4a30-b88d-c174af80d316","credentials":{"httpHeaderAuth":{"id":"w6eQTrKmyY1Vtb6i","name":"OCR Batch Trigger"}}},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-1120,0],"id":"781735e7-aec4-4a7a-8fbb-18729e15c01a","name":"Start OCR batch"},{"parameters":{"options":{"reset":false}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[32,-16],"id":"db3a4af0-d3fd-4edc-82ad-6f500a9c6003","name":"Process one image at a time"},{"parameters":{"url":"https://cloud-api.yandex.net/v1/disk/public/resources","sendQuery":true,"queryParameters":{"parameters":[{"name":"public_key","value":"https://disk.yandex.ru/d/UeiGaC7MhEXjCw"},{"name":"limit","value":"1000"}]},"options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[-896,0],"id":"ea1fd13b-8573-4098-80fa-9c0fae215ec0","name":"List public images","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"parameters":{"jsCode":"const root = $input.first().json;\nconst publicKey = root.public_key || 'https://disk.yandex.ru/d/UeiGaC7MhEXjCw';\nconst files = (root._embedded?.items || [])\n  .filter(item => item.type === 'file' && /^image\\/(png|jpeg|webp|tiff)$/i.test(item.mime_type || ''))\n  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));\n\nif (!files.length) throw new Error('No supported images found in public folder');\n\nreturn files.map(file => {\n  const baseName = file.name.replace(/\\.[^.]+$/, '');\n  return { json: {\n    publicKey,\n    path: file.path,\n    name: file.name,\n    md5: file.md5,\n    outputPath: `/OCR/protocol/txt/${baseName}.txt`,\n  }};\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-672,0],"id":"f95eb962-2f93-4abc-a048-f728808db34d","name":"Natural sort and map filenames"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO ocr_jobs (source_public_key, source_path, source_name, source_md5, output_path)\nVALUES ($1, $2, $3, $4, $5)\nON CONFLICT (source_public_key, source_path) DO UPDATE SET\n  source_name = EXCLUDED.source_name,\n  output_path = EXCLUDED.output_path,\n  status = CASE\n    WHEN ocr_jobs.source_md5 IS DISTINCT FROM EXCLUDED.source_md5 THEN 'pending'\n    WHEN ocr_jobs.status = 'processing' AND ocr_jobs.updated_at < now() - interval '30 minutes' THEN 'retry'\n    ELSE ocr_jobs.status\n  END,\n  source_md5 = EXCLUDED.source_md5,\n  updated_at = now()\nRETURNING *, (status IN ('pending', 'retry', 'failed') AND attempts < 4) AS should_process;","options":{"queryReplacement":"={{ $json.publicKey }}, {{ $json.path }}, {{ $json.name }}, {{ $json.md5 }}, {{ $json.outputPath }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-448,0],"id":"fc23821a-8e2b-454c-8d7b-4772500bfcc6","name":"Claim idempotent job","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"8382c6a5-1061-4a11-a52b-9052148fa307","leftValue":"={{ $json.should_process }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-224,0],"id":"ed8af717-d67e-4525-983a-31887223d0f8","name":"Needs OCR"},{"parameters":{"operation":"executeQuery","query":"UPDATE ocr_jobs\nSET status = 'processing', attempts = attempts + 1, started_at = now(), completed_at = NULL, error_message = NULL, updated_at = now()\nWHERE id = $1\nRETURNING *;","options":{"queryReplacement":"={{ $json.id }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[256,0],"id":"913b2679-06dd-46db-9039-f1c8c62bc623","name":"Mark processing","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"url":"https://cloud-api.yandex.net/v1/disk/public/resources/download","sendQuery":true,"queryParameters":{"parameters":[{"name":"public_key","value":"={{ $json.source_public_key }}"},{"name":"path","value":"={{ $json.source_path }}"}]},"options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[464,0],"id":"e071864b-5fd2-44ae-9629-63e74a781589","name":"Get temporary download URL","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"method":"POST","url":"http://127.0.0.1:8765/ocr-url","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({ url: $json.href, source_name: $('Mark processing').item.json.source_name }) }}","options":{"timeout":300000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[672,16],"id":"8ee5221f-2fa1-44b2-a695-88c427d2b7fc","name":"Recognize Korean text","retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"url":"https://cloud-api.yandex.net/v1/disk/resources/upload","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"path","value":"={{ $('Mark processing').item.json.output_path }}"},{"name":"overwrite","value":"true"}]},"options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[880,16],"id":"85d1dcb4-8a28-4c36-b1ab-28986330c841","name":"Get TXT upload URL","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"credentials":{"httpHeaderAuth":{"id":"tOwdWfABKlP8ylhY","name":"Yandex Disk OAuth"}},"onError":"continueErrorOutput"},{"parameters":{"method":"PUT","url":"={{ $json.href }}","sendBody":true,"contentType":"raw","rawContentType":"text/plain; charset=utf-8","body":"={{ $('Recognize Korean text').item.json.text }}","options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1072,16],"id":"c4c97ca2-b14c-4540-a15b-7098795d3463","name":"Upload UTF-8 TXT","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"operation":"executeQuery","query":"UPDATE ocr_jobs\nSET status = 'done', confidence = $2, min_confidence = $3, line_count = $4, text_length = $5, ocr_engine = $6, ocr_version = $7, error_message = NULL, completed_at = now(), updated_at = now()\nWHERE id = $1\nRETURNING id, source_name, output_path, status, confidence, line_count, text_length;","options":{"queryReplacement":"={{ $('Mark processing').item.json.id }}, {{ $('Recognize Korean text').item.json.confidence }}, {{ $('Recognize Korean text').item.json.min_confidence }}, {{ $('Recognize Korean text').item.json.line_count }}, {{ $('Recognize Korean text').item.json.text.length }}, {{ $('Recognize Korean text').item.json.engine }}, {{ $('Recognize Korean text').item.json.engine_version }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1312,0],"id":"def04278-591d-4a32-8507-7974c990de29","name":"Mark done","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"UPDATE ocr_jobs\nSET status = CASE WHEN attempts < 4 THEN 'retry' ELSE 'failed' END, error_message = left($2, 500), updated_at = now()\nWHERE id = $1\nRETURNING id, source_name, status, attempts, error_message;","options":{"queryReplacement":"={{ $('Mark processing').item.json.id }}, {{ String($json.error?.message || $json.message || 'OCR step failed').replaceAll(',', ';') }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":