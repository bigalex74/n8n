			header_up Host {host}
		}
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3080 {
			header_up Host {host}
		}
	}
	handle /portal-api/* {
		uri strip_prefix /portal-api
		reverse_proxy 127.0.0.1:3080 {
			header_up Host {host}
		}
	}
	handle {
		root * /home/user/n8n-docker/portal
		try_files {path} /index.html
		file_server
		encode zstd gzip
	}
}

