hub.bigalexn8n.ru {
	tls alexei.bigalex@yandex.ru

	# Webhook — без auth, Telegram вызывает напрямую; защита — секрет в URL
	handle /webhook/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
		}
	}

	# API — без auth, вызывается из Telegram WebApp (не браузер пользователя)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
		}
	}

	# /docs и /health — без Caddy auth
	handle /docs* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
		}
	}

	handle /health* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
		}
	}

	# Фронт (Telegram WebApp) — без auth, Telegram открывает в webview
	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
		}
	}
}
