[{"updatedAt":"2026-04-26T13:44:29.153Z","createdAt":"2026-04-25T09:48:24.376Z","id":"UmCkmK4Xhtgn1zUI","name":"Sub-Workflow: Gemini HTTP Proxy","description":null,"active":false,"isArchived":true,"nodes":[{"parameters":{},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[0,0],"id":"e2ba34e3-1111-4444-8888-abcdef123456","name":"Execute Workflow Trigger"},{"parameters":{"jsCode":"const input = $input.first().json;\nconst apiKey = input.apiKey;\nconst prompt = input.prompt;\nconst model = input.model || 'gemini-2.5-flash';\nconst temperature = input.temperature !== undefined ? input.temperature : 0.7;\nconst systemInstruction = input.system_instruction;\nconst history = input.history;\n\nif (!apiKey) throw new Error(\"API Key is missing.\");\n\nlet contents = [];\nif (history && Array.isArray(history) && history.length > 0) {\n    contents = history;\n} else {\n    contents = [{ \"role\": \"user\", \"parts\": [{ \"text\": prompt }] }];\n}\n\nconst body = { contents: contents, generationConfig: { temperature: temperature } };\nif (systemInstruction) { body.system_instruction = { parts: [{ \"text\": systemInstruction }] }; }\n\nreturn { url: `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`, body: body };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0],"id":"11111111-2222-3333-4444-555555555555","name":"Prepare Payload"},{"parameters":{"method":"POST","url":"={{ $json.url }}","sendBody":true,"specifyBody":"json","jsonBody":"={{ $json.body }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[448,0],"id":"22222222-3333-4444-5555-666666666666","name":"Call Gemini API"},{"parameters":{"jsCode":"const data = $input.first().json;\nlet resultText = \"\";\ntry { resultText = data.candidates[0].content.parts[0].text; } catch(e) { resultText = \"Error or safety block.\"; }\nreturn { response: resultText, raw: data };"},"type":"n8n-nodes-base.code","typeVersion"