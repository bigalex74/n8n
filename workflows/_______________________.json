[{"updatedAt":"2026-07-09T18:55:15.553Z","createdAt":"2026-03-06T02:06:37.154Z","id":"GPARI8V4RBSPL1h39_kHW","name":"[Перевод] Перевод чанка","description":"","active":true,"isArchived":false,"nodes":[{"parameters":{"operation":"executeQuery","query":"SELECT * FROM document_glossary WHERE job_id IN (SELECT job_id FROM job_current);","options":{}},"id":"51afce0c-5c95-4860-b85b-be7d9b48dc9e","name":"Чтение глоссария","type":"n8n-nodes-base.postgres","position":[-368,176],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"select","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"mode":"list","value":"translate_prompts","cachedResultName":"translate_prompts"},"returnAll":true,"options":{}},"id":"a23f9ada-511f-46a9-9663-97cb8d42a399","name":"Чтение промтов","type":"n8n-nodes-base.postgres","position":[-528,176],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"jsCode":"\n// --- DEVOPS SAFETY SWITCH ---\n// const isDevopsTest = $('Execute Workflow Trigger').first().json.is_devops_test === true;\n// if (isDevopsTest) {\nconst  models = {\n    mainModel: 'openai/gpt-5.4',\n    testModel: 'gemini-2.5-flash',\n  };\n//   console.log('⚠️ SAFETY SWITCH: Overridden to Free Gemini via Bridge');\n// }\n// ----------------------------\nlet UserPrompt = '';\nlet SystemPrompt = '';\nlet PostProductPrompt = '';\n\n// User prompt\nconst roller_summary = $('Получение rolling summary главы для промта').first().json?.roller_summary;\nif (roller_summary && Object.keys(roller_summary)?.length) {\n  UserPrompt += `\n## КРАТКОЕ СОДЕРЖАНИЕ ПРЕДЫДУЩЕЙ ГЛАВЫ:\n${JSON.stringify(roller_summary)}\n`;\n}\n\nconst roller_summary_arc = $('Чтение текущей арки').first().json.summary;\nif (roller_summary_arc && Object.keys(roller_summary_arc)?.length) {\n  UserPrompt += `\n## КРАТКОЕ ОПИСАНИЕ ТЕКУЩЕЙ АРКИ:\n${JSON.stringify(roller_summary_arc)}\n`;\n}\n\nif ($('Выбор чанка для перевода').first().json?.prev_line) {\n  UserPrompt += `\n<CONTEXT_BEFORE>\n${$('Выбор чанка для перевода').first().json.prev_line}\n</CONTEXT_BEFORE>\n`;\n}\n\nUserPrompt += `\n## ПЕРЕВЕДИ СТРОГО НА РУССКИЙ:\n${$('Выбор чанка для перевода').first().json.chunk_text}\n`;\n\n//System Prompt\nSystemPrompt += $('Чтение промтов').all().find(item => item.json.name === 'BP Default')?.json?.prompt || '';\n\nlet glossary_text = '';\nconst glossary = $('Чтение глоссария').all();\nglossary_text = glossary.map((item) => \n  Object.keys(item.json).length \n  ? `${item.json.name} = ${item.json.translate}${item.json.gender ? ' (gender: ' + (item.json.gender.toLowerCase().includes('муж') ? 'male' : (item.json.gender.toLowerCase().includes('жен') ? 'female' : item.json.gender)) + ').'  : '.'}` : '').join('\\n');\nif (glossary_text.length) {\n  glossary_text = \n`━━━━━━━━━━━━━━━━━━━━━━━━━━━\nГЛОССАРИЙ — ИСТОЧНИК ИСТИНЫ\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\n${glossary_text}`;\n}\nSystemPrompt = SystemPrompt.replace('{{GLOSSARY}}', glossary_text)\n\nlet customPrompt = $('Чтение промтов').all().find(item => item.json.name === 'BP BL')?.json?.prompt || '';\nif (customPrompt) {\n  customPrompt =`\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\nROMAN_RULES — ПРИМЕНЯТЬ ВСЕГДА. БЕЗ ИСКЛЮЧЕНИЙ.\nИМЕЮТ ПРИОРИТЕТ НАД ВСЕМИ ОСТАЛЬНЫМИ ПРАВИЛАМИ.\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\n${customPrompt}`;\n}\nSystemPrompt = SystemPrompt.replace('{{ROMAN_RULES}}', customPrompt)\n\nlet contestBefore_text = ''\nif ($('Выбор чанка для перевода').first().json?.prev_line) {\n  contestBefore_text += `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\nСЕКЦИЯ<CONTEXT_BEFORE>\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\nНЕ переводить.\nИспользовать только для улучшения связности основного текста.\n`\n}\nSystemPrompt = SystemPrompt.replace('{{CONTEXT_BEFORE}}', contestBefore_text)\n\nconst light_rag = `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\nБАЗА ЗНАНИЙ МИРА (КОНТЕКСТ ИЗ RAG)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━\nСледующие факты извлечены из истории новеллы. Используй их для соблюдения логики событий и отношений между персонажами:\n${$('Запрос в LightRAG').first().json.response}\n`;\nSystemPrompt = SystemPrompt.replace('{{LIGHT_RAG}}', light_rag)\n\nlet isRomanRules = 'Чётко отслеживается, кто говорит и кто действует?';\nif (customPrompt) isRomanRules = 'ROMAN_RULES соблюдены?';\nSystemPrompt = SystemPrompt.replace('{{IS_ROMAN_RULES}}', isRomanRules)\n\nreturn { UserPrompt, SystemPrompt, PostProductPrompt, models };\n"},"id":"5afbff5e-93f0-4be1-8a61-5bed4aa9f112","name":"Формирование промтов для перевода","type":"n8n-nodes-base.code","position":[-352,384],"typeVersion":2},{"parameters":{"operation":"executeQuery","query":"UPDATE  document_chunks SET status = 'processing', updated_at = now()\n  WHERE id = {{ $('Выбор чанка для перевода').first().json.id }};\n\nUPDATE  document_chapters SET status = 'processing', updated_at = now()\n  WHERE id = {{ $('Выбор чанка для перевода').item.json.chapter }};\n  ","options":{"queryReplacement":"='{{ $input.all() }}'"}},"id":"b49cd2cc-8887-4638-8d60-5ba740f4c6cf","name":"Перевод чанка в статус proccessing","type":"n8n-nodes-base.postgres","position":[-768,384],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM document_chapters WHERE job_id IN (SELECT job_id FROM job_current) AND id = {{ $('Выбор чанка для перевода').item.json.chapter }};","options":{}},"id":"758487df-aee5-4de1-bea4-f24c5cdcc98f","name":"Получение rolling summary главы для промта","type":"n8n-nodes-base.postgres","position":[-560,384],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"execu