перевода 1 чанка: \n       ${ (avv_time).toLocaleString()} сек.\n💰 Средняя стоимость 1 чанка ≈\n       ₽ ${ avv_cost.toFixed(2) }\n\n📄 <b>Документ был поделен на:</b>\n       Главы - ${$('Количество глав').first().json.count}\n       Арки - ${$('Количество арок').first().json.count}\n\n${source !== 'telegram' ? `<a href=\"${$('Данные document_jobs').first().json.web_chapters_link}\">Summary</a>\\n` : ''}\n${source != 'telegram' ? '📁 <i>Файл сохранён на Google Drive</i>' : ''}\n`,\n  type: 'create'\n}\n\nif (source != 'telegram')\n  message.button = {\n    name: '📂 Открыть файл',\n    text: $('Данные document_jobs').first().json.web_view_link || 'http://link.com'\n  }\n\nreturn { ...message }"},"id":"7a9c666d-5f37-47b6-b534-52d13719cf92","name":"Сообщение Перевод завершен","type":"n8n-nodes-base.code","position":[-880,688],"typeVersion":2},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"select_files"}},"id":"0570cb3b-9c43-43f3-a384-c66c231c4cf3","name":"Get row(s)","type":"n8n-nodes-base.dataTable","position":[-416,384],"typeVersion":1.1},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM document_jobs a, job_current b WHERE a.id =b.job_id;","options":{}},"id":"2a2f9ff9-c8e8-4502-a1c9-d4a35e2c3dda","name":"Данные document_jobs","type":"n8n-nodes-base.postgres","position":[-672,160],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"SELECT count(*) as chunks_total FROM document_chunks WHERE job_id IN (SELECT job_id FROM job_current);","options":{}},"id":"65674073-63e5-47d5-bbd8-0cf2b7964066","name":"Общее количество чанков","type":"n8n-nodes-base.postgres","position":[-480,160],"executeOnce":true,"retryOnFail":true,"typeVersion":2.6,"alwaysOutputData":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"