 htmlCaption = rawText.replaceAll(/\\n/g, '<br>');\n }\n\n // ПРОВЕРКА ЛИМИТА TELEGRAM (1024 символа для фото)\n const TG_LIMIT = 1024;\n if (htmlCaption.length > TG_LIMIT) {\n     htmlCaption = htmlCaption.substring(0, TG_LIMIT - 3) + \"...\";\n }\n\n return {\n     html_text: htmlCaption\n };"},"id":"665cddcd-94a6-4ee6-ab4b-394c530fc925","name":"Подготовка текста аннотации","type":"n8n-nodes-base.code","position":[-240,384],"typeVersion":2},{"parameters":{"url":"https://polza.ai/api/v1/balance","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[]},"options":{"timeout":10000}},"id":"b08f1aef-f23a-4025-a5fd-6296e6bd8ff4","name":"Billing Polza.ai","type":"n8n-nodes-base.httpRequest","position":[-1088,160],"retryOnFail":true,"typeVersion":4.4,"alwaysOutputData":true,"credentials":{"httpHeaderAuth":{"id":"3dfmGKUa1Q01H200","name":"Billing Polza Header"}},"onError":"continueRegularOutput"},{"parameters":{"url":"https://neuroapi.host/v1/dashboard/billing/usage","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[]},"options":{"timeout":10000}},"id":"ac36cd4a-84d4-43d7-909e-3908f96dd91f","name":"Billing Neuro","type":"n8n-nodes-base.httpRequest","position":[-880,160],"retryOnFail":true,"typeVersion":4.4,"alwaysOutputData":true,"credentials":{"httpHeaderAuth":{"id":"GIoKsxpIObYHo6Nm","name":"Billing Neuro Header"}},"onError":"continueRegularOutput"},{"parameters":{"operation":"sendPhoto","chatId":"={{ $('Get row(s)').item.json.chat_id }}","file":"={{ $('Анотация').item.json.url }}","additionalFields":{"caption":"={{ $json.html_text }}","disable_notification":true,"parse_mode":"HTML"}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-1280,688],"id":"971bd453-ea24-42bf-8b57-7811cbaeee30","name":"Send a photo message","webhookId":"edd04996-850a-4287-9493-f929669bdee5","retryOnFail":true,"credentials":{"telegr