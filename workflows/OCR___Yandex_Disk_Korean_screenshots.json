[{"updatedAt":"2026-07-16T21:15:37.562Z","createdAt":"2026-07-13T17:48:46.284Z","id":"KoreanOcrYd2026A","name":"OCR — Yandex Disk Korean screenshots","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"ocr-yandex-korean-batch","authentication":"headerAuth","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1712,-176],"id":"2f4ea17c-2539-456c-aed1-3b17240ad29c","name":"Authenticated batch webhook","webhookId":"c74eea09-95b6-4a30-b88d-c174af80d316","credentials":{"httpHeaderAuth":{"id":"w6eQTrKmyY1Vtb6i","name":"OCR Batch Trigger"}}},{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-1696,208],"id":"781735e7-aec4-4a7a-8fbb-18729e15c01a","name":"Start OCR batch"},{"parameters":{"options":{"reset":false}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[32,-16],"id":"db3a4af0-d3fd-4edc-82ad-6f500a9c6003","name":"Process one image at a time"},{"parameters":{"url":"https://cloud-api.yandex.net/v1/disk/resources","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"path","value":"/Yulia/+ Test/протокол"},{"name":"limit","value":"1000"}]},"options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[-896,0],"id":"ea1fd13b-8573-4098-80fa-9c0fae215ec0","name":"List owned images","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"credentials":{"httpHeaderAuth":{"id":"tOwdWfABKlP8ylhY","name":"Yandex Disk OAuth"}}},{"parameters":{"jsCode":"const root = $input.first().json;\nconst publicKey = root.public_key;\nconst sourceFolder = '/Yulia/+ Test/протокол';\nconst batchId = $('Acquire OCR batch').first().json.batch_id;\nconst requested = $('Normalize batch request').first().json.force_files || [];\nconst requestedNames = new Set(requested.map(name => String(name).toLocaleLowerCase()));\nif (root.type !== 'dir' || root.path !== 'disk:' + sourceFolder) {\n  throw new Error('Authenticated Yandex folder does not match the configured OCR source');\n}\nif (!publicKey) {\n  throw new Error('Configured OCR source folder is not public');\n}\nconst items = root._embedded?.items || [];\nconst outputNames = new Set(items\n  .filter(item => item.type === 'file' && /\\.txt$/i.test(item.name || ''))\n  .map(item => item.name.toLocaleLowerCase()));\nlet files = items\n  .filter(item => item.type === 'file' && /^image\\/(png|jpeg|webp|tiff)$/i.test(item.mime_type || ''))\n  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));\n\nif (!files.length) throw new Error('No supported images found in owned source folder');\nconst baseNames = files.map(file => file.name.replace(/\\.[^.]+$/, '').toLocaleLowerCase());\nif (new Set(baseNames).size !== baseNames.length) {\n  throw new Error('Duplicate image basenames would overwrite the same TXT file');\n}\nif (requestedNames.size) {\n  const availableNames = new Set(files.map(file => file.name.toLocaleLowerCase()));\n  const missing = [...requestedNames].filter(name => !availableNames.has(name));\n  if (missing.length) throw new Error('Requested OCR images were not found: ' + missing.join(', '));\n  files = files.filter(file => requestedNames.has(file.name.toLocaleLowerCase()));\n}\n\nreturn files.map(file => {\n  const baseName = file.name.replace(/\\.[^.]+$/, '');\n  return { json: {\n    publicKey,\n    path: `/${file.name}`,\n    name: file.name,\n    md5: file.md5,\n    outputPath: `${sourceFolder}/${baseName}.txt`,\n    outputExists: outputNames.has((baseName + '.txt').toLocaleLowerCase()),\n    forceProcess: requestedNames.has(file.name.toLocaleLowerCase()),\n    batchId,\n  }};\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-672,0],"id":"f95eb962-2f93-4abc-a048-f728808db34d","name":"Natural sort and map filenames"},{"parameters":{"operation":"executeQuery","query":"INSERT INTO ocr_jobs (source_public_key, source_path, source_name, source_md5, output_path, last_batch_id, last_batch_process_requested)\nVALUES ($1, $2, $3, $4, $5, $6, true)\nON CONFLICT (source_public_key, source_path) DO UPDATE SET\n  source_name = EXCLUDED.source_name,\n  output_path = EXCLUDED.output_path,\n  status = CASE\n    WHEN $7::boolean OR NOT $8::boolean OR ocr_jobs.source_md5 IS DISTINCT FROM EXCLUDED.source_md5 THEN 'pending'\n    WHEN ocr_jobs.status = 'processing' AND ocr_jobs.updated_at < now() - interval '30 minutes' THEN 'retry'\n    ELSE ocr_jobs.status\n  END,\n  attempts = CASE\n    WHEN $7::boolean OR NOT $8::boolean OR ocr_jobs.source_md5 IS DISTINCT FROM EXCLUDED.source_md5 THEN 0\n    ELSE ocr_jobs.attempts\n  END,\n  last_batch_process_requested = (\n    $7::boolean OR NOT $8::boolean OR ocr_jobs.source_md5 IS DISTINCT FROM EXCLUDED.source_md5\n    OR ((ocr_jobs.status IN ('pending', 'retry', 'failed')\n      OR (ocr_jobs.status = 'processing' AND ocr_jobs.updated_at < now() - interval '30 minutes'))\n      AND ocr_jobs.attempts < 4)\n  ),\n  source_md5 = EXCLUDED.source_md5,\n  last_batch_id = EXCLUDED.last_batch_id,\n  updated_at = now()\nRETURNING *, last_batch_process_requested AS should_process;","options":{"queryReplacement":"={{ $json.publicKey }}, {{ $json.path }}, {{ $json.name }}, {{ $json.md5 }}, {{ $json.outputPath }}, {{ $json.batchId }}, {{ $json.forceProcess }}, {{ $json.outputExists }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-448,0],"id":"fc23821a-8e2b-454c-8d7b-4772500bfcc6","name":"Claim idempotent job","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"8382c6a5-1061-4a11-a52b-9052148fa307","leftValue":"={{ $json.should_process }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-bas