0), 'running'\n  WHERE NOT EXISTS (\n    SELECT 1 FROM ocr_batch_runs\n    WHERE status = 'running' AND started_at >= now() - interval '12 hours'\n  )\n  ON CONFLICT DO NOTHING\n  RETURNING id, chat_id, requested_by, started_at\n)\nSELECT\n  EXISTS (SELECT 1 FROM claimed) AS claimed,\n  coalesce((SELECT id FROM claimed), 0) AS batch_id,\n  coalesce((SELECT chat_id FROM claimed), NULLIF($1::bigint, 0)) AS chat_id,\n  coalesce((SELECT requested_by FROM claimed), NULLIF($2::bigint, 0)) AS requested_by,\n  coalesce((SELECT id FROM ocr_batch_runs WHERE status = 'running' ORDER BY started_at DESC LIMIT 1), 0) AS active_batch_id;","options":{"queryReplacement":"={{ $json.chat_id }}, {{ $json.requested_by }}"}}},{"id":"f0331574-2614-4772-8292-f9fdf87ae104","name":"Batch acquired?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-672,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"260d7fda-44c5-4da5-b169-81f6cb773105","leftValue":"={{ $json.claimed }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"24475809-3e0e-4ae1-bd97-1102ffd5e106","name":"Has duplicate recipient?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-448,176],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"af1a936a-4cc3-419d-bb85-489ffb231107","leftValue":"={{ Number($json.chat_id || 0) > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"d20c7db2-1036-4a4b-85fe-92dd4a256108","name":"Report duplicate batch","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-224,176],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"parameters":{"chatId":"={{ $json.chat_id }}","text":"OCR уже выполняется. Второй пакет не запущен