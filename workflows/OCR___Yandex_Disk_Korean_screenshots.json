etweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"url":"https://cloud-api.yandex.net/v1/disk/resources/upload","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"path","value":"={{ $('Mark processing').item.json.output_path }}"},{"name":"overwrite","value":"true"}]},"options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[880,16],"id":"85d1dcb4-8a28-4c36-b1ab-28986330c841","name":"Get TXT upload URL","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"credentials":{"httpHeaderAuth":{"id":"tOwdWfABKlP8ylhY","name":"Yandex Disk OAuth"}},"onError":"continueErrorOutput"},{"parameters":{"method":"PUT","url":"={{ $json.href }}","sendBody":true,"contentType":"raw","rawContentType":"text/plain; charset=utf-8","body":"={{ $('Recognize Korean text').item.json.text }}","options":{"timeout":60000}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1072,16],"id":"c4c97ca2-b14c-4540-a15b-7098795d3463","name":"Upload UTF-8 TXT","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"operation":"executeQuery","query":"UPDATE ocr_jobs\nSET status = 'done', confidence = $2, min_confidence = $3, line_count = $4, text_length = $5, ocr_engine = $6, ocr_version = $7, error_message = NULL, completed_at = now(), updated_at = now()\nWHERE id = $1\nRETURNING id, source_name, output_path, status, confidence, line_count, text_length;","options":{"queryReplacement":"={{ $('Mark processing').item.json.id }}, {{ $('Recognize Korean text').item.json.confidence }}, {{ $('Recognize Korean text').item.json.min_confidence }}, {{ $('Recognize Korean text').item.json.line_count }}, {{ $('Recognize Korean text').item.json.text.length }}, {{ $('Recognize Korean text').item.json.engine }}, {{ $('Recognize Korean text').item.json.engine_version }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1312,0],"id":"def04278-591d-4a32-8507-7974c990de29","name":"Mark done","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"UPDATE ocr_jobs\nSET status = CASE WHEN attempts < 4 THEN 'retry' ELSE 'failed' END, error_message = left($2, 500), updated_at = now()\nWHERE id = $1\nRETURNING id, source_name, status, attempts, error_message;","options":{"queryReplacement":"={{ $('Mark processing').item.json.id }}, {{ String($json.error?.message || $json.message || 'OCR step failed').replaceAll(',', ';') }}"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1328,224],"id":"3d29acfe-2cb3-4de3-ab60-0357ebc106db","name":"Mark retry or failed","credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"id":"36ec6829-d789-44e7-93b9-f7ad82b6e101","name":"Telegram OCR command","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-1344,176],"parameters":{"workflowInputs":{"values":[{"name":"chat_id","type":"number"},{"name":"requested_by","type":"number"},{"name":"force_files","type":"array"},{"name":"engine","type":"string"},{"name":"model","type":"string"},{"name":"prompt","type":"string"}]}}},{"id":"111f9fd2-6383-43c9-bdf3-3a39c057e102","name":"Normalize batch request","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1120,0],"parameters":{"jsCode":"const payload = $json.body ?? $json;\nconst message = payload.message ?? {};\nconst forceFiles = Array.isArray(payload.force_files) ? [...new Set(payload.force_files.map(String))] : [];\nconst engine = payload.engine === 'ai' ? 'ai' : 'paddle';\nconst allowedModels = new Set(['gpt-5.6-luna', 'gpt-5.6-terra', 'gpt-5.6-sol']);\nconst model = engine === 'ai' && allowedModels.has(String(payload.model || '')) ? String(payload.model) : (engine === 'ai' ? 'gpt-5.6-luna' : '');\nconst prompt = engine === 'ai' ? String(payload.prompt || '') : '';\nif (engine === 'ai' && (prompt.trim().length < 20 || prompt.length > 12000)) throw new Error('Invalid AI OCR prompt');\nreturn [{ json: {\n  chat_id: Number(payload.chat_id ?? message.chat?.id ?? 0) || 0,\n  requested_by: Number(payload.requested_by ?? message.from?.id ?? 0) || 0,\n  force_files: forceFiles,\n  engine,\n  model,\n  prompt_b64: Buffer.from(prompt, 'utf8').toString('base64'),\n} }];"}},{"id":"44524d52-cb5e-4c82-99bc-bb4234e4e103","name":"Acquire OCR batch","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-896,0],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"WITH stale AS (\n  UPDATE ocr_batch_runs\n  SET status = 'failed', finished_at = now(), updated_at = now(),\n      failed_files = coalesce(failed_files, 'stale batch auto-closed')\n  WHERE status = 'running' AND started_at < now() - interval '12 hours'\n  RETURNING id\n), claimed AS (\n  INSERT INTO ocr_batch_runs (chat_id, requested_by, status, ocr_engine, ai_model, ai_prompt)\n  SELECT NULLIF($1::bigint, 0), NULLIF($2::bigint, 0), 'running', $3::text,\n         NULLIF($4::text, '__none__'),\n         CASE WHEN $3::text = 'ai' THEN convert_from(decode($5::text, 'base64'), 'UTF8') ELSE NULL END\n  WHERE NOT EXISTS (\n    SELECT 1 FROM ocr_batch_runs\n    WHERE status = 'running' AND started_at >= now() - interval '12 hours'\n  )\n  ON CONFLICT DO NOTHING\n  RETURNING id, chat_id, requested_by, started_at, ocr_engine, ai_model, ai_prompt\n)\nSELECT\n  EXISTS (SELECT 1 FROM claimed) AS claimed,\n  coalesce((SELECT id FROM claimed), 0) AS batch_id,\n  coalesce((SELECT chat_id FROM claimed), NULLIF($1::bigint, 0)) AS chat_id,\n  coalesce((SELECT requested_by FROM claimed), NULLIF($2::bigint, 0)) AS requested_by,\n  (SELECT ocr_engine FROM claimed) AS ocr_engine,\n  (SELECT ai_model FROM claimed) AS ai_model,\n  (SELECT ai_prompt FROM claimed) AS ai_prompt,\n  coalesce((SELECT id FROM ocr_batch_runs WHERE status = 'running' ORDER BY started_at DESC LIMIT 1), 0) AS active_batch_id;","options":{"queryReplacement":"={{ $json.chat_id }}, {{ $json.requested_by }}, {{ $json.engine }}, {{ $json.model || '__none__' }}, {{ $json.prompt_b64 || '__none__' }}"}}},{"id":"f0331574-2614-4772-8292-f9fdf87ae104","name":"Batch acquired?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-672,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"260d7fda-44c5-4da5-b169-81f6cb773105","leftValue":"={{ $json.claimed }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"24475809-3e0e-4ae1-bd97-1102ffd5e106","name":"Has duplicate recipient?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-448,176],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"af1a936a-4cc3-419d-bb85-489ffb231107","leftValue":"={{ Number($json.chat_id || 0) > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"d20c7db2-1036-4a4b-85fe-92dd4a256108","name":"Report duplicate batch","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-224,176],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"parameters":{"chatId":"={{ $json.chat_id }}","text":"OCR уже выполняется. Второй пакет не запущен. По окончании текущего запуска придёт отчёт.","additionalFields":{"appendAttribution":false,"disable_notification":false}}},{"id":"9a9a5715-5b03-4ebd-b913-1d38a9bd9109","name":"Finalize OCR batch","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[224,-320],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"WITH stats AS (\n  SELECT\n    count(*)::int AS total_discovered,\n    count(*) FILTER (WHERE last_batch_process_requested IS TRUE AND status = 'done')::int AS processed_count,\n    count(*) FILTER (WHERE last_batch_process_requested IS NOT TRUE AND status = 'done')::int AS skipped_count,\n    count(*) FILTER (WHERE status <> 'done')::int AS failed_count,\n    string_agg(source_name, ', ' ORDER BY source_name) FILTER (WHERE status <> 'done') AS failed_files\n  FROM ocr_jobs\n  WHERE last_batch_id = $1\n), updated AS (\n  UPDATE ocr_batch_runs b\n  SET status = CASE WHEN b.cancel_requested THEN 'cancelled' WHEN s.failed_count = 0 THEN 'done' ELSE 'partial' END,\n      total_discovered = s.total_discovered,\n      processed_count = s.processed_count,\n      skipped_count = s.skipped_count,\n      failed_count = s.failed_count,\n      failed_files = s.failed_files,\n      progress_total = s.processed_count + s.failed_count,\n      progress_completed = s.processed_count,\n      progress_failed = s.failed_count,\n      progress_current_file = NULL,\n      finished_at = now(),\n      updated_at = now()\n  FROM stats s\n  WHERE b.id = $1\n  RETURNING b.*\n)\nSELECT * FROM updated;","options":{"queryReplacement":"={{ $('Acquire OCR batch').first().json.batch_id }}"}}},{"id":"311f798a-b8a9-44c1-91fa-94eefaf1e110","name":"Has report recipient?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[448,-320],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"4ad3f7f9-a9b7-489f-a513-e03c90a2e111","leftValue":"={{ Number($json.chat_id || 0) > 0 && Number($json.telegram_message_id || 0) > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"b15a879c-eec5-439b-aa9f-d75774da0112","name":"Send OCR completion report","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[672,-320],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.chat_id }}","text":"={{ (($json.status === 'cancelled') ? '⏹ OCR остановлен' : ($json.failed_count > 0 ? '⚠️ OCR завершён с ошибками' : '✅ OCR завершён')) + '\\n\\n' + (($json.status === 'cancelled') ? 'Обработка остановлена после текущего файла.' : '████████████ 100%') + '\\nНайдено картинок: ' + $json.total_discovered + '\\nРаспознано заново: ' + $json.processed_count + '\\nБез изменений: ' + $json.skipped_count + '\\nОшибок: ' + $json.failed_count + ($json.failed_files ? '\\nПроблемные файлы: ' + $json.failed_files : '') + '\\n\\nTXT сохранены рядом с изображениями в папке «протокол».' }}","additionalFields":{"appendAttribution":false,"disable_notification":false}}},{"id":"422eadb7-8600-4be8-9b79-52ce9123e113","name":"Has progress recipient?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-448,-96],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"2627ddba-5353-478d-baa2-59fa284230b7","leftValue":"={{ Number($json.chat_id || 0) > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"3af80212-504a-4499-9482-02cd8ffed114","name":"Send OCR progress message","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-224,-160],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"onError":"continueRegularOutput","parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.chat_id }}","text":"⏳ OCR запускается\n\n░░░░░░░░░░░░ 0%\nПодготавливаю список изображений…\n\nСообщение будет обновляться автоматически.","additionalFields":{"appendAttribution":false,"disable_notification":false}}},{"id":"2eb05b03-312a-4a45-8170-d2f2c407e115","name":"Store OCR progress message","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[0,-160],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"UPDATE ocr_batch_runs\nSET telegram_message_id = NULLIF($2::bigint, 0),\n    progress_last_sent_at = CASE WHEN NULLIF($2::bigint, 0) IS NULL THEN NULL ELSE now() END,\n    updated_at = now()\nWHERE id = $1\nRETURNING id, chat_id, requested_by, telegram_message_id;","options":{"queryReplacement":"={{ $('Acquire OCR batch').first().json.batch_id }}, {{ Number($json.result?.message_id || $json.message_id || 0) }}"}}},{"id":"8222daa0-389b-4fe4-a493-f1af31a73016","name":"Update OCR progress snapshot","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1568,-32],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"WITH stats AS (\n  SELECT\n    count(*) FILTER (WHERE last_batch_process_requested IS TRUE)::int AS progress_total,\n    count(*) FILTER (WHERE last_batch_process_requested IS TRUE AND status = 'done')::int AS progress_completed,\n    count(*) FILTER (WHERE last_batch_process_requested IS TRUE AND status IN ('retry', 'failed'))::int AS progress_failed\n  FROM ocr_jobs\n  WHERE last_batch_id = $1\n), decision AS (\n  SELECT b.id, s.progress_total, s.progress_completed, s.progress_failed,\n    (s.progress_completed + s.progress_failed) AS finished_count,\n    (b.telegram_message_id IS NOT NULL AND (\n      s.progress_completed + s.progress_failed >= s.progress_total\n      OR s.progress_completed + s.progress_failed >= b.progress_last_sent_completed + 5\n      OR b.progress_last_sent_at IS NULL\n      OR b.progress_last_sent_at < now() - interval '2 minutes'\n    )) AS should_edit\n  FROM ocr_batch_runs b CROSS JOIN stats s\n  WHERE b.id = $1\n), updated AS (\n  UPDATE ocr_batch_runs b\n  SET progress_total = d.progress_total,\n      progress_completed = d.progress_completed,\n      progress_failed = d.progress_failed,\n      progress_current_file = NULLIF($2::text, ''),\n      progress_last_sent_completed = CASE WHEN d.should_edit THEN d.finished_count ELSE b.progress_last_sent_completed END,\n      progress_last_sent_at = CASE WHEN d.should_edit THEN now() ELSE b.progress_last_sent_at END,\n      updated_at = now()\n  FROM decision d\n  WHERE b.id = d.id\n  RETURNING b.*, d.should_edit\n)\nSELECT * FROM updated;","options":{"queryReplacement":"={{ $('Acquire OCR batch').first().json.batch_id }}, {{ $json.source_name || '' }}"}}},{"id":"7672bc07-db31-42f7-b51d-6b0aa6123117","name":"Should edit OCR progress?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1792,-32],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"b6134218-f23e-4ff8-a877-174f8d55fc67","leftValue":"={{ $json.should_edit }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"e093c396-ad73-4314-b3e9-66359e3cc118","name":"Edit OCR progress message","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[2016,-96],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"onError":"continueRegularOutput","parameters":{"resource":"message","operation":"editMessageText","messageType":"message","chatId":"={{ $json.chat_id }}","messageId":"={{ $json.telegram_message_id }}","text":"={{ (() => { const total = Number($json.progress_total || 0); const completed = Number($json.progress_completed || 0); const failed = Number($json.progress_failed || 0); const finished = completed + failed; const percent = total > 0 ? Math.min(100, Math.floor(finished * 100 / total)) : 0; const width = 12; const filled = Math.min(width, Math.floor(percent * width / 100)); const bar = '█'.repeat(filled) + '░'.repeat(width - filled); const started = new Date($json.started_at).getTime(); const elapsedSeconds = Number.isFinite(started) ? Math.max(0, Math.floor((Date.now() - started) / 1000)) : 0; const etaSeconds = finished > 0 && total > finished ? Math.floor(elapsedSeconds / finished * (total - finished)) : 0; const duration = (seconds) => { if (!seconds) return '—'; const minutes = Math.max(1, Math.ceil(seconds / 60)); return minutes < 60 ? minutes + ' мин' : Math.floor(minutes / 60) + ' ч ' + (minutes % 60) + ' мин'; }; return '⏳ OCR выполняется\\n\\n' + bar + ' ' + percent + '%\\nГотово: ' + finished + ' из ' + total + '\\nУспешно: ' + completed + '\\nОшибок: ' + failed + ($json.progress_current_file ? '\\nПоследний файл: ' + $json.progress_current_file : '') + '\\nОсталось примерно: ' + duration(etaSeconds) + '\\n\\nСообщение обновляется автоматически.'; })() }}","replyMarkup":"none","additionalFields":{"appendAttribution":false}}},{"id":"44c3b1d9-2ad8-4b5f-b30c-6f595a531119","name":"Edit OCR completion report","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[672,-384],"credentials":{"telegramApi":{"id":"V4jPr27PQcfRRHY9","name":"Telegram account"}},"onError":"continueRegularOutput","parameters":{"resource":"message","operation":"editMessageText","messageType":"message","chatId":"={{ $json.chat_id }}","messageId":"={{ $json.telegram_message_id }}","text":"={{ (($json.status === 'cancelled') ? '⏹ OCR остановлен' : ($json.failed_count > 0 ? '⚠️ OCR завершён с ошибками' : '✅ OCR завершён')) + '\\n\\n' + (($json.status === 'cancelled') ? 'Обработка остановлена после текущего файла.' : '████████████ 100%') + '\\nНайдено картинок: ' + $json.total_discovered + '\\nРаспознано заново: ' + $json.processed_count + '\\nБез изменений: ' + $json.skipped_count + '\\nОшибок: ' + $json.failed_count + ($json.failed_files ? '\\nПроблемные файлы: ' + $json.failed_files : '') + '\\n\\nTXT сохранены рядом с изображениями в папке «протокол».' }}","replyMarkup":"none","additionalFields":{"appendAttribution":false}}},{"id":"bece7583-781d-43bb-ac62-e01778927120","name":"Has fallback report recipient?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[672,-256],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"18cc33bf-baad-4eb8-a18b-76b18b530c45","leftValue":"={{ Number($json.chat_id || 0) > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"f21a43cb-3090-4c87-a925-15b7e1ba3121","name":"Check OCR cancellation","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1120,160],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"SELECT j.*, j.last_batch_process_requested AS should_process, b.cancel_requested\nFROM ocr_jobs j\nJOIN ocr_batch_runs b ON b.id = $1\nWHERE j.id = $2;","options":{"queryReplacement":"={{ $('Acquire OCR batch').first().json.batch_id }}, {{ $json.id }}"}}},{"id":"1e244508-f010-47d0-bb0a-052225a53122","name":"Cancellation requested?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1344,160],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"8ef558e0-b619-4768-949d-91129dc83123","leftValue":"={{ $json.cancel_requested }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"366f044a-64e9-43df-9cce-daec9cef3124","name":"Cancel OCR batch","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1568,224],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}},"parameters":{"operation":"executeQuery","query":"WITH stats AS (\n  SELECT\n    count(*)::int AS total_discovered,\n    count(*) FILTER (WHERE last_batch_process_requested IS TRUE AND status = 'done')::int AS processed_count,\n    count(*) FILTER (WHERE last_batch_process_requested IS NOT TRUE AND status = 'done')::int AS skipped_count,\n    count(*) FILTER (WHERE status IN ('retry', 'failed'))::int AS failed_count,\n    string_agg(source_name, ', ' ORDER BY source_name) FILTER (WHERE status IN ('retry', 'failed')) AS failed_files\n  FROM ocr_jobs\n  WHERE last_batch_id = $1\n), updated AS (\n  UPDATE ocr_batch_runs b\n  SET status = 'cancelled',\n      total_discovered = s.total_discovered,\n      processed_count = s.processed_count,\n      skipped_count = s.skipped_count,\n      failed_count = s.failed_count,\n      failed_files = s.failed_files,\n      progress_completed = s.processed_count,\n      progress_failed = s.failed_count,\n      progress_current_file = NULL,\n      finished_at = now(),\n      updated_at = now()\n  FROM stats s\n  WHERE b.id = $1 AND b.status = 'running'\n  RETURNING b.*\n)\nSELECT * FROM updated;","options":{"queryReplacement":"={{ $('Acquire OCR batch').first().json.batch_id }}"}}}],"connections":{"Authenticated batch webhook":{"main":[[{"node":"Normalize batch request","type":"main","index":0}]]},"Start OCR batch":{"main":[[{"node":"Normalize batch request","type":"main","index":0}]]},"Telegram OCR command":{"main":[[{"node":"Normalize batch request","type":"main","index":0}]]},"Normalize batch request":{"main":[[{"node":"Acquire OCR batch","type":"main","index":0}]]},"Acquire OCR batch":{"main":[[{"node":"Batch acquired?","type":"main","index":0}]]},"Batch acquired?":{"main":[[{"node":"Has progress recipient?","type":"main","index":0}],[{"node":"Has duplicate recipient?","type":"main","index":0}]]},"Has progress recipient?":{"main":[[{"node":"Send OCR progress message","type":"main","index":0}],[{"node":"List owned images","type":"main","index":0}]]},"Send OCR progress message":{"main":[[{"node":"Store OCR progress message","type":"main","index":0}]]},"Store OCR progress message":{"main":[[{"node":"List owned images","type":"main","index":0}]]},"Has duplicate recipient?":{"main":[[{"node":"Report duplicate batch","type":"main","index":0}],[]]},"List owned images":{"main":[[{"node":"Natural sort and map filenames","type":"main","index":0}]]},"Natural sort and map filenames":{"main":[[{"node":"Claim idemp