[{"updatedAt":"2026-06-15T07:10:47.028Z","createdAt":"2026-04-04T05:32:29.369Z","id":"2kztTVutdATd1MDS","name":"Анотация","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"workflowInputs":{"values":[{"name":"job_id","type":"number"}]}},"id":"26985294-d91c-4893-afc0-9d72aafdf505","name":"Start Workflow","type":"n8n-nodes-base.executeWorkflowTrigger","position":[-480,-16],"typeVersion":1.1},{"parameters":{"workflowId":{"__rl":true,"mode":"list","value":"AW58nseQdLtJn5ZO","cachedResultUrl":"/workflow/AW58nseQdLtJn5ZO","cachedResultName":"sub_lightrag_api"},"workflowInputs":{"value":{"action":"summary"},"schema":[{"id":"action","type":"string","display":true,"removed":false,"required":false,"displayName":"action","defaultMatch":false,"canBeUsedToMatch":true},{"id":"text","type":"string","display":true,"removed":true,"required":false,"displayName":"text","defaultMatch":false,"canBeUsedToMatch":true},{"id":"texts","type":"array","display":true,"removed":true,"required":false,"displayName":"texts","defaultMatch":false,"canBeUsedToMatch":true},{"id":"meta_data","type":"string","display":true,"removed":true,"required":false,"displayName":"meta_data","defaultMatch":false,"canBeUsedToMatch":true}],"mappingMode":"defineBelow","matchingColumns":[],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"id":"a58b482a-0543-4972-b3cd-ae6f923ae42e","name":"Summary book","type":"n8n-nodes-base.executeWorkflow","position":[-304,-16],"typeVersion":1.3},{"parameters":{"promptType":"define","text":"=ДАННЫЕ О КНИГЕ ИЗ БАЗЫ ЗНАНИЙ:\n{{ $('Summary book').first().json.response }}\n-------------\nНа основе этих данных составь пост по правилам из системного промпта.\n","messages":{"messageValues":[{"message":"=Ты — эксперт по вирусному маркетингу и продвижению веб-новелл. \nТвоя задача: на основе данных из базы знаний (RAG) составить захватывающий рекламный пост для Telegram для русскоязычных читателей.\n\nПРАВИЛА ОФОРМЛЕНИЯ:\n1. КЛИКБЕЙТ: Придумай вариант взрывного заголовка. Используй капс, интригу и обещание силы/тайны.\n2. АННОТАЦИЯ: Напиши краткий, интригующий текст (3-4 предложения). Фокусируйся на конфликте героя (внутреннем и внешнем) и опасности мира. Язык должен быть живым, \"литературным\", но       современным.\n3. ЭМОДЗИ: Используй их умеренно, для акцентов.\n4. ХЕШТЕГИ: Добавь 5-7 штук в конце.\n\nФОРМАТ ВЫВОДА (СТРОГО):\n🔥 [Лучший заголовок]\n---\n📖 [Интригующая аннотация]\n---\n#Хештеги"}]},"batching":{}},"id":"ae1838fa-5ad1-4ff8-ae15-ed133c77f5f9","name":"Basic LLM Chain","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[448,-16],"typeVersion":1.9},{"parameters":{"assignments":{"assignments":[{"id":"9f59e9e1-07ab-4296-99af-2ffcc1c21b06","name":"text","type":"string","value":"={{ $json.text }}"},{"id":"d714c3c0-09ae-4f0d-98a7-7197de94055b","name":"url","type":"string","value":"={{ $('Download Image').item.json.url }}"}]},"options":{}},"id":"1f6787c2-463f-4e9d-aa6c-98b5acc04ac1","name":"return","type":"n8n-nodes-base.set","position":[736,-16],"typeVersion":3.4},{"parameters":{"jsCode":"const prompt = $input.first().json.output;\n// Кодируем промпт для URL\nconst encodedPrompt = encodeURIComponent(prompt);\n// Генерируем случайный seed для уникальности картинки\nconst seed = Math.floor(Math.random() * 1000000);\n\nreturn {\n  url: `https://image.pollinations.ai/prompt/${encodedPrompt}?width=1024&height=1024&seed=${seed}&nologo=true&model=flux`,\n  prompt: prompt\n};"},"id":"116d3ec6-b187-43a0-acb1-d0e1ae6aebf5","name":"Prepare Image URL","type":"n8n-nodes-base.code","typeVersion":2,"position":[128,-16]},{"parameters":{"url":"={{ $json.url }}","options":{}},"id":"a3c7e02d-4a5b-49a3-987e-74a7b9dc594a","name":"Download Image","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[288,-16]},{"parameters":{"model":{"__rl":true,"value":"google/gemini-2.5-flash","mode":"list","cachedResultName":"google/gemini-2.5-flash"},"builtInTools":{},"options":{}},"id":"3e6ab845-3001-4969-8e0c-56b78ccc0312","name":"Gemini 2.5 flash","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[160,304],"typeVersion":1.3,"credentials":{"openAiApi":{"id":"dw2ygQ53RyVkCAva","name":"Polza"}}},{"parameters":{"promptType":"define","text":"=### ОПИСАНИЕ ИЗ БАЗЫ ЗНАНИЙ:\n{{ $json.response }}\n---------------------------------------\nСоставь на основе этих данных финальный промпт для Flux.\nСтиль обложки: manhwa\n---------------------------------------","options":{"systemMessage":"Ты — профессиональный арт-директор и эксперт по промпт-инжинирингу для современных нейросетей (Flux, Midjourney). \nТвоя задача: на основе предоставленного описания персонажей и сюжета из базы знаний составить один идеальный, детализированный промпт на АНГЛИЙСКОМ языке для генерации обложки новеллы.\n\nПРАВИЛА СОСТАВЛЕНИЯ:\n1. Выходной промпт должен быть только на английском языке.\n2. Обязательно опиши: \n  - Главного героя (внешность, одежда, поза).\n  - Его магию или ключевое оружие (из описания RAG).\n  - Задний план (ключевая локация).\n  - Атмосферу (эпичность, мрак, свет, мистика).\n  - Избегай слишком мрачныее описания\n  - Главный герой обязательно должен присутствовать на обложке - чтобы было видно его лицо (часть лица)\n3. Добавь технические теги для качества: \"professional digital illustration, manhwa style, highly detailed, cinematic lighting, masterpiece\".\n4. Формат ответа: выдай ТОЛЬКО текст промпта, без вводных фраз."}},"id":"c211a2ea-d3d1-49e4-b74e-711c2bb0c644","name":"Promt","type":"@n8n/n8n-nodes-langchain.agent","position":[-144,-16],"typeVersion":3.1}],"connections":{"Start Workflow":{"main":[[{"node":"Summary book","type":"main","index":0}]]},"Summary book":{"main":[[{"node":"Promt","type":"main","index":0}]]},"Basic LLM Chain":{"main":[[{"node":"return","type":"main","index":0}]]},"Prepare Image URL":{"main":[[{"node":"Download Image","type":"main","index":0}]]},"Download Image":{"main":[[{"node":"Basic LLM Chain","type":"main","index":0}]]},"Gemini 2.5 flash":{"ai_la