[{"updatedAt":"2026-06-30T04:50:07.185Z","createdAt":"2026-04-04T05:32:29.369Z","id":"2kztTVutdATd1MDS","name":"Анотация","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"workflowInputs":{"values":[{"name":"job_id","type":"number"}]}},"id":"26985294-d91c-4893-afc0-9d72aafdf505","name":"Start Workflow","type":"n8n-nodes-base.executeWorkflowTrigger","position":[-480,-16],"typeVersion":1.1},{"parameters":{"workflowId":{"__rl":true,"mode":"list","value":"AW58nseQdLtJn5ZO","cachedResultUrl":"/workflow/AW58nseQdLtJn5ZO","cachedResultName":"sub_lightrag_api"},"workflowInputs":{"mappingMode":"defineBelow","value":{"action":"summary","text":"={{ $('Start Workflow').first().json.job_id }}"},"matchingColumns":[],"schema":[{"id":"action","type":"string","display":true,"removed":false,"required":false,"displayName":"action","defaultMatch":false,"canBeUsedToMatch":true},{"id":"text","type":"string","display":true,"removed":false,"required":false,"displayName":"text","defaultMatch":false,"canBeUsedToMatch":true},{"id":"texts","type":"array","display":true,"removed":true,"required":false,"displayName":"texts","defaultMatch":false,"canBeUsedToMatch":true},{"id":"meta_data","type":"string","display":true,"removed":true,"required":false,"displayName":"meta_data","defaultMatch":false,"canBeUsedToMatch":true}],"attemptToConvertTypes":true,"convertFieldsToString":true},"options":{}},"id":"a58b482a-0543-4972-b3cd-ae6f923ae42e","name":"Summary book","type":"n8n-nodes-base.executeWorkflow","position":[-304,-16],"typeVersion":1.3},{"parameters":{"promptType":"define","text":"=ДАННЫЕ О КНИГЕ ИЗ БАЗЫ ЗНАНИЙ:\n{{ $('Summary book').first().json.response }}\n-------------\nНа основе этих данных составь пост по правилам из системного промпта.\n","messages":{"messageValues":[{"message":"=Ты — эксперт по вирусному маркетингу и продвижению веб-новелл. \nТвоя задача: на основе данных из базы знаний (RAG) составить захватывающий рекламный пост для Telegram для русскоязычных читателей.\n\nПРАВИЛА ОФОРМЛЕНИЯ:\n1. КЛИКБЕЙТ: Придумай вариант взрывного заголовка. Используй капс, интригу и обещание силы/тайны.\n2. АННОТАЦИЯ: Напиши краткий, интригующий текст (3-4 предложения). Фокусируйся на конфликте героя (внутреннем и внешнем) и опасности мира. Язык должен быть живым, \"литературным\", но       современным.\n3. ЭМОДЗИ: Используй их умеренно, для акцентов.\n4. ХЕШТЕГИ: Добавь 5-7 штук в конце.\n\nФОРМАТ ВЫВОДА (СТРОГО):\n🔥 [Лучший заголовок]\n---\n📖 [Интригующая аннотация]\n---\n#Хештеги"}]},"batching":{}},"id":"ae1838fa-5ad1-4ff8-ae15-ed133c77f5f9","name":"Basic LLM Chain","type":"@n8n/n8n-nodes-langchain.chainLlm","position":[448,-16],"typeVersion":1.9},{"parameters":{"assignments":{"assignments":[{"id":"9f59e9e1-07ab-4296-99af-2ffcc1c21b06","name":"text","type":"string","value":"={{ $json.text }}"},{"id":"d714c3c0-09ae-4f0d-98a7-7197de94055b","name":"url","type":"string","value":"={{ $('Download Image').item.json.url }}"}]},"options":{}},"id":"1f6787c2-463f-4e9d-aa6c-98b5acc04ac1","name":"return","type":"n8n-nodes-base.set","position":[736,-16],"typeVersion":3.4},{"parameters":{"jsCode":"const prompt = $input.first().json.output;\n// Кодируем промпт для URL\nconst encodedPrompt = encodeURIComponent(prompt);\n// Генерируем случайный seed для уникальности картинки\nconst seed = Math.floor(Math.random() * 1000000);\n\nreturn {\n  url: `https://image.pollinations.ai/prompt/${encodedPrompt}?width=1024&height=1024&seed=${seed}&nologo=true&model=flux`,\n  prompt: prompt\n};"},"id":"116d3ec6-b187-43a0-acb1-d0e1ae6aebf5","name":"Prepare Image URL","type":"n8n-nodes-base.code","position":[128,-16],"typeVersion":2},{"parameters":{"jsCode":"const input = $input.first().json;\nconst pollinationsUrl = input.url;\nconst prompt = input.prompt;\n\nasync function sleep(ms) {\n  return new Promise(resolve => setTimeout(resolve, ms));\n}\n\nasync function pollinationsReady(url) {\n  try {\n    const response = await fetch(url, { method: 'GET' });\n    const contentType = response.headers.get('content-type') || '';\n    if (response.ok && contentType.startsWith('image/')) {\n      return { ok: true, status: response.status };\n    }\n    let body = '';\n    try {\n      body = await response.text();\n    } catch (error) {}\n    return { ok: false, status: response.status, body: body.slice(0, 500) };\n  } catch (error) {\n    return { ok: false, status: 0, body: error.message };\n  }\n}\n\nasync function generateWithAiHorde(prompt) {\n  const headers = {\n    'Content-Type': 'application/json',\n    'apikey': '0000000000',\n    'Client-Agent': 'masha-openclaw:1:https://openclaw.local'\n  };\n  const create = await fetch('https://aihorde.net/api/v2/generate/async', {\n    method: 'POST',\n    headers,\n    body: JSON.stringify({\n      prompt,\n      params: {\n        width: 512,\n        height: 512,\n        steps: 24,\n        n: 1,\n        sampler_name: 'k_euler_a',\n        cfg_scale: 7\n      },\n      nsfw: false,\n      censor_nsfw: true,\n      trusted_workers: false\n    })\n  });\n  if (!create.ok) {\n    throw new Error('AI Horde create failed: ' + create.status + ' ' + (await create.text()).slice(0, 300));\n  }\n  const created = await create.json();\n  if (!created.id) throw new Error('AI Horde did not return request id');\n\n  for (let attempt = 0; attempt < 24; attempt++) {\n    await sleep(5000);\n    const check = await fetch('https://aihorde.net/api/v2/generate/check/' + created.id, { headers });\n    if (!check.ok) continue;\n    const state = await check.json();\n    if (state.faulted) throw new Error('AI Horde request faulted');\n    if (state.done) {\n      const status = await fetch('https://aihorde.net/api/v2/generate/status/' + created.id, { headers });\n      if (!status.ok) throw new Error('AI Horde status failed: ' + status.status);\n      const result = await status.json();\n      const imageUrl = result.generations?.[0]?.img;\n      if (imageUrl) return { url: imageUrl, request_id: created.id, model: result.generations?.[0]?.model };\n      throw new Error('AI Horde finished without image URL');\n    }\n  }\n  throw new Error('AI Horde timeout after 120 seconds');\n}\n\nconst pollinations = await pollinationsReady(pollinationsUrl);\nif (pollinations.ok) {\n  return {\n    url: pollinationsUrl,\n    prompt,\n    image_provider: 'pollinations',\n    pollinations_status: pollinations.status\n  };\n}\n\ntry {\n  const horde = await generateWithAiHorde(prompt);\n  return {\n    url: horde.url,\n    prompt,\n    image_provider: 'aihorde',\n    fallback_reason: pollinations,\n    aihorde_request_id: horde.request_id,\n    aihorde_model: horde.model\n  };\n} catch (error) {\n  return {\n    url: pollinationsUrl,\n    prompt,\n    image_provider: 'pollinations-unverified',\n    image_warning: error.message,\n    fallback_reason: pollinations\n  };\n}"},"id":"a3c7e02d-4a5b-49a3-987e-74a7b9dc594a","name":"Download Image","type":"n8n-nodes-base.code","position":[288,-16],"typeVersion":2,"notes":"Checks Pollinations first; falls back to anonymous AI Horde if Pollinations returns queue/payment errors."},{"parameters":{"model":{"__rl":true,"mode":"list","value":"google/gemini-2.5-flash","cachedResultName":"google/gemini-2.5-flash"},"builtInTools":{},"options":{}},"id":"3e6ab845-3001-4969-8e0c-56b78ccc0312","name":"Gemini 2.5 flash","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[160,304],"typeVersion":1.3,"credentials":{"openAiApi":{"id":"dw2ygQ53RyVkCAva","name":"Polza"}}},{"parameters":{"promptType":"define","text":"=### ОПИСАНИЕ ИЗ БАЗЫ ЗНАНИЙ:\n{{ $json.response }}\n---------------------------------------\nСоставь на основе этих данных финальный промпт для Flux.\nСтиль обложки: manhwa\n---------------------------------------","options":{"systemMessage":"Ты — профессиональный арт-директор и эксперт по промпт-инжинирингу для современных нейросетей (Flux, Midjourney). \nТвоя задача: на основе предоставленного описания персонажей и сюжета из базы знаний составить один идеальный, детализированный промпт на АНГЛИЙСКОМ языке для генерации обложки новеллы.\n\nПРАВИЛА СОСТАВЛЕНИЯ:\n1. Выходной промпт должен быть только на английском языке.\n2. Обязательно опиши: \n  - Главного героя (внешность, одежда, поза).\n  - Его магию или ключевое оружие (из описания RAG).\n  - Задний план (ключевая локация).\n  - Атмосферу (эпичность, мрак, свет, мистика).\n  - Избегай слишком мрачныее описания\n  - Главный герой обязательно должен присутствовать на обложке - чтобы было видно его лицо (часть лица)\n3. Добавь технические теги для качества: \"professional digital illustration, manhwa style, highly detailed, cinematic lighting, masterpiece\".\n4. Формат ответа: выдай ТОЛЬКО текст промпта, без вводных фраз."}},"id":"c211a2ea-d3d1-49e4-b74e-711c2bb0c644","name":"Promt","type":"@n8n/n8n-nodes-langchain.agent","position":[-144,-16],"typeVersion":3.1}],"connections":{"Promt":{"main":[[{"node":"Prepare Image URL","type":"main","index":0}]]},"Summary book":{"main":[[{"node":"Promt","type":"main","index":0}]]},"Download Image":{"main":[[{"node":"Basic LLM Chain","type":"main","index":0}]]},"Start Workflow":{"main":[[{"node":"Summary book","type":"main","index":0}]]},"Basic LLM Chain":{"main":[[{"node":"return","type":"main","index":0}]]},"Gemini 2.5 flash":{"ai_languageModel":[[{"node":"Promt","type":"ai_languageModel","index":0},{"node":"Basic LLM Chain","type":"ai_languageModel","index":0}]]},"Prepare Image URL":{"main":[[{"node":"Download Image","type":"main","index":0}]]}},"settings":{"binaryMode":"separate","callerPolicy":"workflowsFromSameOwner","errorWorkflow":"global-error-handler-36id","timeSavedMode":"fixed","availableInMCP":false,"executionOrder":"v1","saveFailedExecution":"all","saveManualExecutions":true,"saveExecutionProgress":"none","saveDataSuccessExecution":"none"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{"Start Workflow":[{"json":{"job_id":86}}]},"versionId":"d7c423dc-a897-4163-a27d-b64916