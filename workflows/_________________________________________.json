[{"updatedAt":"2026-08-01T18:05:27.269Z","createdAt":"2026-03-18T00:18:11.430Z","id":"lSuNRX0VILP9Lgit5VKlK","name":"Предварительный анализ файла для перевода","description":"","active":true,"isArchived":false,"nodes":[{"parameters":{"operation":"executeQuery","query":"INSERT INTO document_chunks (job_id, chunk_index, chunk_text, prev_line, chapter)\nSELECT \n   {{ $('Start Workflow').first().json.job_id }},\n   CAST(t.json->>'index_chunk' as INTEGER),\n   t.json->>'chunk' as text,\n   t.json->>'prev_line' as text,\n   document_chapters.id\n  FROM \n    json_to_recordset($1) AS t(json json), document_chapters\n  WHERE \n    document_chapters.chapter_number = CAST(t.json->>'chapter' as integer) \n      AND \n    document_chapters.job_id = {{ $('Start Workflow').first().json.job_id }};\n\n","options":{"queryReplacement":"='{{ $('Подготовка к разбиению на чанки').all() }}'"}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[544,-208],"id":"7fbc748c-bb4d-4182-9888-f1e73ab96e3d","name":"Добавим все чанки для перевода в БД","executeOnce":true,"alwaysOutputData":true,"retryOnFail":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"options":{"reset":false}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[176,-16],"id":"b4806bdc-8b6c-4fb1-b1ef-c6fb62b353d6","name":"Loop Over Items"},{"parameters":{},"type":"n8n-nodes-base.noOp","name":"Replace Me1","typeVersion":1,"position":[2048,304],"id":"111dd4ec-32ff-4921-ab09-a0fc9bd68ef0"},{"parameters":{"jsCode":"/**\n * @method Цельный текст разбиваем по предложениям c группировкой по 200 предлжений\n * @description Предложения обычно отделены либо \\n, либо \\n\\n\n * @returns {index_chunk} - номер чанка\n *          {chank} - список предложенеий {} \n */\n\nlet lineCR = '\\n\\n';\nconst MAX_CHUNKS = 200;\nconst chunks = [];\nlet current_divider = 0;\nlet current_chunk = [];\nlet index_line = 1;\nif ($('Чтение файла для перевода').first().json.json.mimeType === 'text/plain') { lineCR = '\\n' };\nfor (const item of $('Start Workflow').first().json.text.split(lineCR)) {\n  if (!item.length) continue;\n  current_chunk.push({index_line, item});\n  index_line++;\n  if (index_line % MAX_CHUNKS === 0) {\n    chunks.push({ index_chunk: current_divider, chank: current_chunk });\n    current_chunk = [];\n    current_divider++;\n  }\n}\nif (current_chunk.length) {\n  chunks.push({ index_chunk: current_divider, chank: current_chunk });\n}\n\nreturn chunks;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-48,-16],"id":"a88f61e6-96a6-4130-a561-2961dcb609ed","name":"Разбиваем текст для структурного анализа"},{"parameters":{"operation":"select","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"temp_table","mode":"list","cachedResultName":"temp_table"},"sort":{"values":[{"column":"id"}]},"options":{"outputColumns":["chapter"]}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-224,-208],"id":"69dfdbed-dafd-4a9e-a57f-aefe9f013b7e","name":"Список глав после структурного анализа","executeOnce":true,"alwaysOutputData":true,"retryOnFail":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"jsCode":"const MAX_LINES_IN_CHUNK = 20;\nconst ret = [];\n\n// нормализация масива с границами глав\nconst arr_chapters = $('Подготовка глав к добавлению в БД').all().reduce((acc,item) => {\n  acc.push(item.json.chapter) \n  return acc.flat();\n}, [])\n\n// нормализация строк всего текста\nconst arr_lines = $('Разбиваем текст для структурного анализа').all().reduce((acc, item) => {\n  acc.push(item.json.chank)\n  return acc.flat()\n}, [])\n\nconst last_chapter_number = arr_chapters.reduce((acc, item) => acc > item.chapter_number ? acc : item.chapter_number, 0);\n// вставим доп запись, чтобы мы могли вставить текст от начала последней главы до конца текста\narr_chapters.push({\n  chapter_number: last_chapter_number + 1,\n  line: arr_lines.length + 1\n})\n\n// нарежем текст на фрагменты для перевода с учетом глав\nlet prev_index = -1;\nlet index = 0;\nlet chunk = '';\nlet prev_line = '';\nfor (const item of arr_chapters) {\n  if (prev_index === -1) {\n    prev_index = item.line;\n    continue\n  }\n\n  let current_index = 0;\n  chunk = '';\n  \n  for (let i=prev_index; i<item.line; i++) {\n    chunk = chunk + arr_lines[i-1].item;\n    current_index++;\n    if (current_index > MAX_LINES_IN_CHUNK) {\n      ret.push({chunk, prev_line, index_chunk: index, chapter: item.chapter_number - 1 });\n      chunk = '';\n      prev_line = arr_lines[i-2].item +'\\n\\n'+ arr_lines[i-1].item;\n      index++;\n      current_index = 0;\n    } else chunk = chunk + '\\n\\n';\n  }\n  if (chunk.length > 0) {\n    ret.push({chunk, prev_line, index_chunk: index, chapter: item.chapter_number - 1 });\n    index++;\n    const arr_chunk = chunk.split('\\n\\n').filter(item => item);\n    if (arr_chunk.length > 1) prev_line = arr_chunk[arr_chunk.length-2];\n    else prev_line = '';\n    prev_line += `\\n\\n${arr_chunk[arr_chunk.length-1]}`;\n  }\n  prev_index = item.line;\n};\nreturn ret;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[352,-208],"id":"599f7c0e-5a27-44b9-bd07-43226e85f11d","name":"Подготовка к разбиению на чанки"},{"parameters":{"text":"={{ $('Loop Over Items').item.json.chank.map(item => `${item.index_line}: ${item.item}`).join('\\n') }}","schemaType":"fromJson","jsonSchemaExample":"{\n  \"chapter_starts\":[\n    {\n      \"line\":12,\n      \"heading_line_exact\":\"제1화...\",\n      \"is_chapter_start\":true,\n      \"confidence\":1\n    }\n  ],\n  \"glossary\":[\n    {\n      \"KO\":\"소정서\",\n      \"RU\":\"Со Чонсо\",\n      \"Пол\":\"мужской\"\n    }\n  ]\n}","options":{"systemPromptTemplate":"={{ $('Промт для анализа').first().json.prompt }}"}},"type":"@n8n/n8n-nodes-langchain.informationExtractor","typeVersion":1.2,"position":[416,0],"id":"89d308da-89e4-40ae-a155-4016a4d73245","name":"Information Extractor","retryOnFail":true,"waitBetweenTries":5000,"onError":"continueErrorOutput"},{"parameters":{"jsCode":"// ===== НОДА: \"Подготовка глав к добавлению в БД\" (воркфлоу: Предварительный анализ файла для перевода) =====\n// ПАТЧ: добавлен предохранитель от схлопывания хвоста книги в одну гигантскую \"главу\".\n// Точка интеграции выбрана здесь намеренно: эта нода питает СРАЗУ две ветки\n// (запись глав в БД и нарезку чанков), поэтому сплит здесь = согласованная нумерация в обеих.\n\nconst list_chapters = $(\"Список глав после структурного анализа\").all();\nlet ret = [];\n\nlist_chapters.forEach(item => {\n  item.json.chapter?.length && ret.push(item.json.chapter)\n})\n\nret = ret\n  .flat()\n  .sort((a,b) => a.line - b.line)\n  .filter(item => item.confidence >= 0.7)\n  .reduce((acc, item) => {\n    if (!acc.length) return [item];\n    if (item.line - (acc[acc.length - 1].line) > 5) acc.push(item);\n    return acc\n  }, [])\n\nif (ret.length && ret[0].line !==1) ret.unshift({chapter_number: 0, line: 1})\nret = ret.map((item, index) => ({...item, chapter_number: index + 1}));\n\n// ===================== ПРЕДОХРАНИТЕЛЬ (добавлено) =====================\n// Нормальная глава ~10 чанков (~200 строк), легит-большая видели до ~360 строк.\n// Если \"глава\" больше порога — это почти всегда потерянные границы (детектор не дал\n// confidence>=0.7 на хвосте/外전/эпилоге), и весь хвост схлопнулся в один блок.\n// Тогда: режем форс-границами и громко предупреждаем (не молча!).\nconst MAX_LINES_IN_CHAPTER = 600; // 30 чанков * 20 строк = 3x нормы. Тюнить тут.\n\n// общее число строк текста — чтобы оценить размер ПОСЛЕДНЕЙ главы (до конца файла)\nconst __totalLines = $('Разбиваем текст для структурного анализа').all()\n  .reduce((acc, it) => acc + (it.json.chank ? it.json.chank.length : 0), 0);\n\nconst __withEnd = [...ret, { chapter_number: ret.length + 1, line: __totalLines + 1 }];\nconst __guarded = [];\nconst __forcedLines = [];\nconst guard_warnings = [];\n\nfor (let k = 0; k < __withEnd.length; k++) {\n  __guarded.push(__withEnd[k]);\n  if (k < __withEnd.length - 1) {\n    const start = __withEnd[k].line;\n    const span = __withEnd[k + 1].line - start;\n    if (span > MAX_LINES_IN_CHAPTER) {\n      const parts = Math.ceil(span / MAX_LINES_IN_CHAPTER);\n      for (let p = 1; p < parts; p++) {\n        const ln = start + p * MAX_LINES_IN_CHAPTER;\n        __guarded.push({ line: ln });   // синтетическая граница (без _forced в объекте главы!)\n        __forcedLines.push(ln);\n      }\n      guard_warnings.push(`Строка ${start}: глава ${span} строк (порог ${MAX_LINES_IN_CHAPTER}) — форс-сплит на ${parts} частей`);\n    }\n  }\n}\n__guarded.pop(); // убрать конечный sentinel\n\n// перенумеровать непрерывно 1..N; форму объектов оставляем как у оригинала\nret = __guarded\n  .sort((a, b) => a.line - b.line)\n  .map((item, index) => ({ ...item, chapter_number: index + 1 }));\n\nif (guard_warnings.length) {\n  console.warn('[CHAPTER-GUARD] сработал предохранитель размера главы:', JSON.stringify(guard_warnings));\n}\n// =====================================================================\n\nreturn { chapter: ret, guard_warnings, forced_split_lines: __forcedLines };\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-32,-208],"id":"b71b4535-930a-41f0-a12b-2fa888a88137","name":"Подготовка глав к добавлению в БД"},{"parameters":{"operation":"executeQuery","query":"-- Добавим первую арку\nINSERT INTO document_arcs (job_id, arc_number) VALUES ({{ $('Start Workflow').first().json.job_id }}, 1);\n\n-- Добавляем список всех глав\nINSERT INTO document_chapters (job_id, chapter_number)\nSELECT \n  {{ $('Start Workflow').first().json.job_id }},\n  (json->>'chapter_number')::integer\nFROM\n  json_array_elements('{{ JSON.stringify($json.chapter) }}') as json;\n\n\n-- Первая глава имеет первую арку \nUPDATE document_chapters SET arc_id = (SELECT id FROM document_arcs WHERE job_id = {{ $('Start Workflow').first().json.job_id }} AND arc_number=1 LIMIT 1)\nWHERE job_id = {{ $('Start Workflow').first().json.job_id }}\nAND chapter_number in (\nSELECT \n  (json->>'chapter_number'):: integer\nFROM\n  json_array_elements('{{ JSON.stringify($json.chapter) }}') as json order by json->>'chapter_number' LIMIT 1\n);\n\n-- Первая арка будет иметь началом первую главу\nUPDATE document_arcs SET start_chapter=(SELECT (json->>'chapter_number'):: integer FROM json_array_elements('{{ JSON.stringify($json.chapter) }}') as json order by json->>'chapter_number' LIMIT 1)\nWHERE job_id={{ $('Start Workflow').first().json.job_id }} AND arc_number=1;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[160,-208],"id":"a812c5fc-e191-44e4-8861-03ef9ed765db","name":"Добавление глав в БД","alwaysOutputData":true,"executeOnce":true,"retryOnFail":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"workflowInputs":{"values":[{"name":"job_id","type":"number"},{"name":"text"},{"name":"glossary_make","type":"boolean"}]}},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-1024,-16],"id":"cf07cf73-e7c5-49ba-8f17-87a9aa7fa32b","name":"Start Workflow"},{"parameters":{"operation":"executeQuery","query":"SELECT\n  translate_file_data json\nFROM\n  document_files\nORDER BY\n  id DESC\nLIMIT 1;","options":{}},"id":"b8664b53-2071-46b0-a45a-f5f0472d4588","name":"Чтение файла для перевода","type":"n8n-nodes-base.postgres","typeVersion":2.1,"position":[-400,-16],"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"jsCode":"let prompt = `Вход: текст с номерами строк в формате \"000123: ...\".\n`;\n\nif ($('Start Workflow').first().json.glossary_make) {\n  prompt +=`\nУ тебя 2 задачи.\n\n---------------------------------\nЗадача 1: найти НАЧАЛА глав.\n---------------------------------\n\n`;\n} else {\n    prompt +=`\n---------------------------------\nТвоя задача: найти НАЧАЛА глав.\n---------------------------------\n`;\n}\n\nprompt += `\nПоле JSON: \"chapter_starts\"\n\nТы анализируешь структуру текста на корейском языке. Перевод не нужен.\n\nПравила:\n- Возвращай только те строки, которые являются заголовками глав (제N화/제N장/Chapter/Episode и т.п.) или явно помечают начало главы.\n- Не интерпретировать.\n- Если явных заголовков нет, определяй логические переходы между сценами, которые явно обозначают начало новой главы.\n- Не выдумывай новые главы.\n- Если не уверен — не добавляй границу.\n- (поле: confidence) Оцени уверенность: Присвой каждой границе главы оценку уверенности от 0 до 1. \n   Например: 1 — абсолютная уверенность (например, для явных обозначений глав),  0.5 — предположительно здесь должно быть разбиение.\n- Объем главы строго больше 5 строк\n`;\n\nif ($('Start Workflow').first().json.glossary_make) {\n  prompt += `\n---------------------------------\nЗадача 2: постепенно формировать и поддерживать единый глоссарий.\n---------------------------------\nПоле JSON: \"glossary\"\n\nТы — система ведения глоссария для корейского текста.  Перевод на русский язык обязателен.\n\nИзвлекай из текста:\n- имена персонажей\n- кланы / организации / фракции\n- титулы / ранги / должности\n- техники / способности / навыки\n- артефакты и предметы\n- названия мест\n- уникальные термины мира \n- часто встречающиеся понятия\n\nФормат ответа всегда выводи только таблицу: KO, RU, Пол \nЗначение колонок: \nKO — оригинальное написание на корейском из текста. \nRU — перевод или русская транскрипция. \nПол — только для персонажей. Возможные значения пола: мужской, женский, неизвестно. \nДля всех не-персонажей ставь: — \n\nПравила:\n1. Для корейских имён персонажей используй русскую транскрипцию, а не перевод.\n2. Для терминов и техник используй осмысленный перевод, а не буквальную транскрипцию.\n3. Добавляй только новые элементы, которые ещё не встречались в предыдущих ответах.\n4. Если персонаж был добавлен ранее с полом «неизвестно», и в новом отрывке можно определить пол: выведи эту строку ещё раз, но уже с обновлённым полом.\n5. Пол определяется строго по местоимениям, точному указанию мужчина/женщина, или обращениям хён/нуна/оппа/онни. При гендерно-нейтральном описании и речи запрещено придумывать самому, необходимо указывать: неизвестно.  \n`;\n} else {\n  prompt +=`\nВНИМАНИЕ! Поле \"glossary\" не заполнять!\n  `;\n}\n\nreturn { prompt };"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-224,-16],"id":"6988a8b0-33e4-4f45-8684-13829f6445ed","name":"Промт для анализа"},{"parameters":{"schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"temp_table","mode":"list","cachedResultName":"temp_table"},"columns":{"mappingMode":"defineBelow","value":{"chapter":"={{ $json.output.chapter_starts }}","glossary":"={{ $json.output.glossary }}"},"matchingColumns":["id"],"schema":[{"id":"id","displayName":"id","required":false,"defaultMatch":true,"display":true,"type":"number","canBeUsedToMatch":true,"removed":true},{"id":"chapter","displayName":"chapter","required":false,"defaultMatch":false,"display":true,"type":"object","canBeUsedToMatch":true,"removed":false},{"id":"glossary","displayName":"glossary","required":false,"defaultMatch":false,"display":true,"type":"object","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1520,-16],"id":"1845b779-e895-452a-9e22-797da776faab","name":"Добавление аналитических данных","alwaysOutputData":true,"executeOnce":true,"retryOnFail":true,"credentials":{"postgres":{"id":"iGih4QSBWfmpkdGY","name":"Postgres account"}}},{"parameters":{"schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"document_log","mode":"list","cachedResultName":"document_log"},"columns":{"mappingMode":"defineBelow","value":{"job_id":"={{ $('Start Workflow').first().json.job_id }}","log":"=Файл подготовлен к переводу\nСтрок: {{ $('Разбиваем текст для структурного а